<Window
  FontSize="12"
  Height="400"
  Loaded="Control_OnLoaded"
  Title="AvaloniaDownloader"
  Width="650"
  mc:Ignorable="d"
  x:Class="AvaloniaDownloader.MainWindow"
  x:DataType="downloader:MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:downloader="clr-namespace:AvaloniaDownloader"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid
    Background="LightGoldenrodYellow"
    ColumnDefinitions="85,*"
    RowDefinitions="85,15,*">

    <Border
      Background="Aqua"
      BorderBrush="Black"
      BorderThickness="1"
      Margin="5,0,0,5">
      <!--<Image Source="/Assets/icon.jpg" />-->
    </Border>

    <StackPanel
      Grid.Column="1"
      Grid.Row="0"
      Margin="0,2"
      Orientation="Vertical"
      VerticalAlignment="Center">
      <TextBox
        Margin="5,1"
        TextChanged="TextUrl_OnTextChanged"
        x:Name="TextUrl" />

      <Grid ColumnDefinitions="*,100,100" Margin="0,5">
        <TextBox
          Grid.Column="0"
          HorizontalAlignment="Stretch"
          Margin="5,1"
          x:Name="TextFile" />
        <ComboBox
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          IsEnabled="False"
          Margin="5,1"
          SelectedValue="{Binding SelectedValue}"
          SelectedValueBinding="{Binding Resolution}"
          x:Name="CboQuality" />
        <Button
          Background="White"
          BorderBrush="Black"
          BorderThickness="1"
          Click="Button_OnClick"
          CornerRadius="2"
          Grid.Column="2"
          HorizontalAlignment="Stretch"
          Margin="5,1"
          VerticalAlignment="Stretch"
          x:Name="BtnDownload" />
      </Grid>
    </StackPanel>

    <StackPanel
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Grid.Row="1">
      <Border
        BorderBrush="Black"
        BorderThickness="1"
        Margin="5,0" />
      <ProgressBar
        Background="Aquamarine"
        Foreground="Red"
        Height="20"
        Margin="5,5"
        Maximum="100"
        Minimum="0"
        ShowProgressText="True"
        Value="92"
        x:Name="ProgressDownload" />

      <TextBlock
        Background="Gold"
        Grid.Column="1"
        Grid.ColumnSpan="2"
        Grid.Row="1"
        Height="250"
        HorizontalAlignment="Stretch"
        Margin="5,0"
        x:Name="TxtBlock" />
    </StackPanel>
    <!--
    <ListBox
      Background="Blue"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Grid.Row="2"
      HorizontalAlignment="Stretch"
      Margin="0,1"
      x:Name="ListBox">
      <ListBoxItem />
    </ListBox>
    -->
  </Grid>
</Window>